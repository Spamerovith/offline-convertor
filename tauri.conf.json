{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Offline Convertor",
  "version": "1.2.0",
  "identifier": "local.offline.convertor",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Offline Convertor",
        "width": 1400,
        "height": 900,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "backgroundColor": "#000000",
        "dragDropEnabled": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
